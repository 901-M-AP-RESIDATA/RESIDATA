# =====================================================================
# ResiData - Variables de entorno del backend
# Copiar a .env y ajustar los valores. NUNCA versionar el .env real.
# =====================================================================

# --- Aplicacion ------------------------------------------------------
APP_NOMBRE=ResiData API
APP_VERSION=1.0.0
ENTORNO=desarrollo
DEBUG=false

# --- Base de datos (driver psycopg 3) --------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/residata

# --- Seguridad / JWT -------------------------------------------------
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambiar-este-secreto-por-uno-aleatorio-de-48-bytes
JWT_ALGORITMO=HS256
ACCESS_TOKEN_MINUTOS=30
REFRESH_TOKEN_DIAS=7
# Origenes permitidos para CORS (separados por comas o JSON)
CORS_ORIGENES=http://localhost:5173

# --- IA / clasificacion ----------------------------------------------
# Ruta al archivo de pesos YOLO. Si no existe, el backend usa MODO SIMULADO.
RUTA_MODELO=app/ml/pesos/residuos_yolo.pt
UMBRAL_CONFIANZA=0.60
CATEGORIA_BAJA_CONFIANZA=Peligroso
TIEMPO_MAX_INFERENCIA_MS=2000
TAMANO_MAX_IMAGEN_MB=5

# --- Almacenamiento --------------------------------------------------
DIRECTORIO_ALMACENAMIENTO=storage/imagenes

# --- Usuario administrador inicial (scripts/crear_admin.py) ----------
ADMIN_NOMBRE=Administrador ResiData
ADMIN_CORREO=admin@residata.local
ADMIN_CONTRASENA=Cambiar123!

# --- Logging ---------------------------------------------------------
LOG_NIVEL=INFO
LOG_FORMATO=consola
