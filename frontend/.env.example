# =====================================================================
# ResiData - Variables de entorno del frontend (Vite)
# Copiar a .env y ajustar. Solo las variables con prefijo VITE_ se
# exponen al navegador.
# =====================================================================

# URL base del backend FastAPI (sin barra final)
VITE_API_URL=http://localhost:8000

# Activa datos simulados para trabajar sin backend (true/false)
VITE_USAR_MOCK=false

# Sonido de alerta de residuos peligrosos (true/false)
VITE_SONIDO_ALERTAS=true
