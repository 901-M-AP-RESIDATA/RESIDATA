/*
 * ResiData - Nodo IoT
 * secrets.h.example: credenciales WiFi y destino del servidor FastAPI.
 *
 * NO VERSIONAR CONTENIDO REAL DE CLAVES.
 *
 * 1) Copia este archivo a secrets.h (quedara excluido del repositorio):
 *        cp secrets.h.example secrets.h
 * 2) Rellena los valores con tus credenciales reales.
 *
 * El servidor debe estar en la MISMA red local (solo WiFi 2.4 GHz) y la IP
 * debe ser la de la PC donde corre el backend FastAPI.
 *
 * ESTADO: NO VERIFICADO EN HARDWARE
 */

#pragma once

/* Red WiFi a la que se conectara el nodo (solo 2.4 GHz; el ESP32-CAM no
 * soporta 5 GHz). */
#define WIFI_SSID       "MI_RED_WIFI"
#define WIFI_PASS       "mi_contrasena"

/* Host y puerto del backend FastAPI en la red local (HTTP sin TLS). */
#define SERVER_HOST     "192.168.1.100"
#define SERVER_PORT     8000

/* Identificador del contenedor. Se envia como campo informativo en el
 * multipart (el backend se autentica mediante la X-API-Key). */
#define CONTENEDOR_ID   "1"

/* API key generada por el backend para este contenedor (columna
 * 'api_key' de la tabla contenedores). Sin ella el servidor responde 401. */
#define API_KEY         "cambia_esta_clave"